/* Window-specific layout; shared appearance and controls are in DefaultStyles.uss. */
.becs-graph-studio { flex-grow: 1; }
.becs-graph-studio .studio-projects { height: 30px; }
.becs-graph-studio .studio-projects Label { font-size: 11px; margin-left: 8px; margin-right: 8px; }
.becs-graph-studio .studio-inspector { border-left-width: 1px; padding: 12px; }
.becs-graph-studio .studio-inspector > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container > Label { white-space: normal; margin-top: 5px; margin-bottom: 5px; }
.becs-graph-studio .studio-inspector-title { font-size: 16px; -unity-font-style: bold; }
.becs-graph-studio .studio-status { font-size: 11px; padding: 6px 10px; white-space: normal; }
.becs-graph-studio .studio-method { flex-direction: row; justify-content: space-between; padding: 5px 8px; }
.becs-graph-studio .studio-muted { opacity: 0.65; }
.becs-graph-studio .studio-field-summary { white-space: normal; font-size: 11px; padding: 8px; border-top-width: 1px; }
.becs-graph-studio .studio-disabled { opacity: 0.5; }
.becs-graph-studio .studio-node .extension-container { padding-bottom: 6px; }
.becs-graph-studio .studio-node #studio-kind { font-size: 11px; opacity: 0.65; padding: 4px 8px; }
.becs-graph-studio .studio-compiler-plan .unity-text-field__input { white-space: normal; }
.becs-graph-studio .studio-card { border-width: 1px; border-radius: 5px; overflow: hidden; }
.becs-graph-studio .studio-card.studio-card-selected { border-width: 1px; }
.becs-graph-studio .studio-card-title { -unity-font-style: bold; padding: 9px 10px; white-space: normal; border-bottom-width: 1px; }
.becs-graph-studio .studio-card > Label { white-space: normal; }
.becs-graph-studio .studio-kind { font-size: 11px; opacity: 0.65; padding: 5px 8px; }
.becs-graph-studio .studio-ports { flex-direction: row; padding: 4px; }
.becs-graph-studio .studio-input-port { -unity-text-align: middle-left; }
.becs-graph-studio .studio-output-port { -unity-text-align: middle-right; }
.becs-graph-studio .studio-node-actions { flex-direction: row; border-top-width: 1px; padding: 4px; }
.becs-graph-studio { min-height: 0; }
.becs-graph-studio .studio-projects { height: auto; min-height: 30px; flex-shrink: 0; border-bottom-width: 1px; }
.becs-graph-studio .studio-toolbar { height: auto; min-height: 36px; flex-wrap: wrap; padding: 4px 8px; flex-shrink: 0; }
.becs-graph-studio .studio-graph-field { margin: 6px 12px; flex-shrink: 0; }
.becs-graph-studio .studio-canvas, .becs-graph-studio .studio-inspector { min-height: 0; }
.becs-graph-studio .studio-status { border-top-width: 1px; flex-shrink: 0; }
.becs-graph-studio .studio-kind, .becs-graph-studio .studio-muted { opacity: 1; }
.becs-graph-studio .studio-after-action, .becs-graph-studio .studio-parallel-action { font-size: 11px; margin: 0; padding: 2px 6px; border-radius: 12px; }
.becs-graph-studio .studio-output-port { align-self: flex-end; }
.becs-graph-studio .studio-projects { flex-direction: row; align-items: center; padding: 4px 12px; min-height: 34px; }
.becs-graph-studio .studio-navigation-caption { width: 94px; flex-shrink: 0; font-size: 11px; margin: 0 8px 0 0; }
.becs-graph-studio .studio-navigation-scroll { min-width: 0; }
.becs-graph-studio .studio-navigation-scroll .unity-scroll-view__content-container { align-items: center; }
.becs-graph-studio .studio-toolbar { flex-direction: row; align-items: center; padding: 8px 12px; min-height: 44px; border-bottom-width: 1px; }
.becs-graph-studio .studio-toolbar > Toggle { margin: 2px 4px; }
.becs-graph-studio .studio-breadcrumbs { flex-shrink: 1; min-width: 100px; margin-right: 12px; border-width: 0; }
.becs-graph-studio .studio-after-action { width: 24px; height: 24px; min-height: 24px; min-width: 24px; padding: 0; margin: 0; border-width: 1px; border-radius: 12px; font-size: 17px; -unity-text-align: middle-center; }
.becs-graph-studio .studio-canvas > ScrollView { flex-grow: 1; flex-basis: 0; min-height: 0; }
.becs-graph-studio .studio-canvas .unity-scroll-view__content-viewport { flex-grow: 1; min-height: 0; }
.becs-graph-studio .studio-search-row { flex-direction: row; align-items: center; flex-shrink: 0; padding: 8px 12px; }
.becs-graph-studio .studio-system-search { flex-grow: 1; max-width: 460px; height: 26px; }
.becs-graph-studio .studio-search-results { max-height: 180px; flex-shrink: 0; margin: 0 12px 6px 12px; }
.becs-graph-studio .studio-search-count { font-size: 11px; padding: 4px 0; }
.becs-graph-studio .studio-search-result { flex-direction: row; align-items: center; justify-content: space-between; padding: 7px 10px; margin: 2px 0; }
.becs-graph-studio .studio-result-title { -unity-font-style: bold; flex-shrink: 0; margin-right: 12px; }
.becs-graph-studio .studio-result-path { font-size: 11px; flex-shrink: 1; white-space: normal; }
.becs-graph-studio .studio-inspector { padding: 0; }
.becs-graph-studio .studio-inspector-heading { padding: 16px 14px 12px 14px; }
.becs-graph-studio .studio-inspector-title { font-size: 15px; white-space: normal; margin-top: 5px; }
.becs-graph-studio .studio-inspector-section { margin: 0 12px 12px 12px; padding: 12px; border-width: 1px; border-radius: 6px; }
.becs-graph-studio .studio-section-title { -unity-font-style: bold; font-size: 12px; margin-bottom: 10px; }
.becs-graph-studio .studio-note { font-size: 11px; white-space: normal; }
.becs-graph-studio .studio-inspector-method { flex-direction: row; justify-content: space-between; margin: 2px 0; padding: 6px 8px; }
.becs-graph-studio .studio-inspector-empty { padding: 24px 16px; }
.becs-graph-studio .studio-inspector-empty > Label { margin-bottom: 10px; white-space: normal; }
.becs-graph-studio .studio-system-selection .subclass-selector-container,
.becs-graph-studio .studio-system-selection .open-button,
.becs-graph-studio .studio-system-selection .subclass-selector-label { display: none; }
.becs-graph-studio .studio-system-selection .subclass-selector { flex-direction: column; }
.becs-graph-studio .studio-system-selection .button-selector { width: auto; min-height: 28px; margin: 0 0 6px 0; flex-grow: 1; }
.becs-graph-studio .studio-system-selection .button-text { white-space: normal; }
.becs-graph-studio .studio-inspector-section .unity-base-field { margin: 3px 0; }
.becs-graph-studio .studio-inspector-section .unity-base-field__label { min-width: 88px; width: 100px; white-space: normal; }
.becs-graph-studio .studio-system-search .unity-text-field__input { padding: 4px 8px; border-radius: 4px; font-size: 12px; }
.becs-graph-studio .studio-search-clear { width: 26px; height: 26px; margin-left: 6px; padding: 0; font-size: 16px; }
.becs-graph-studio .studio-system-selection > .studio-note { margin-top: 6px; }
.becs-graph-studio .studio-system-selection .subclass-button-selector { position: relative; top: auto; right: auto; min-width: 0; width: 100%; flex-shrink: 0; }
.becs-graph-studio .studio-system-selection .subclass-selector { padding: 0; }
.becs-graph-studio .studio-system-search { position: relative; }
.becs-graph-studio .studio-system-search .unity-text-field__input { padding-right: 26px; }
.becs-graph-studio .studio-search-clear { position: absolute; right: 4px; top: 3px; width: 20px; height: 20px; min-height: 20px; margin: 0; padding: 0; font-size: 13px; border-width: 0; }
.becs-graph-studio .studio-phase-filter { min-width: 86px; }
.becs-graph-studio .studio-card-header { flex-direction: row; align-items: center; padding: 8px 10px; border-bottom-width: 1px; }
.becs-graph-studio .studio-card-header .studio-card-title { flex-grow: 1; flex-shrink: 1; padding: 0; border-bottom-width: 0; margin-right: 8px; }
.becs-graph-studio .studio-node-enabled { margin: 0 8px 0 0; flex-shrink: 0; }
.becs-graph-studio .studio-card-fields { padding: 10px 8px; border-top-width: 1px; }
.becs-graph-studio .studio-card-fields .unity-base-field { margin: 3px 0; }
.becs-graph-studio .studio-card-fields .unity-base-field__label { min-width: 80px; width: 90px; white-space: normal; }
.becs-graph-studio .studio-card-fields .studio-section-title { font-size: 11px; margin-bottom: 6px; }
.becs-graph-studio .studio-card.studio-phase-inactive { opacity: 0.45; }
.becs-graph-studio .studio-boundary-card { padding: 8px; min-height: 0; }
.becs-graph-studio .studio-parallel-action { min-width: 24px; min-height: 24px; padding: 0; margin: 0; border-radius: 12px; font-size: 16px; -unity-text-align: middle-center; }
.studio-input-port, .studio-output-port { height: 24px; min-width: 24px; justify-content: center; }
.studio-input-port > Label, .studio-output-port > Label { -unity-text-align: middle-center; margin: 0; padding: 0; }
.becs-graph-studio .studio-input-port { align-self: flex-start; width: 24px; }
.becs-graph-studio .studio-output-port { width: 24px; }
.becs-graph-studio .studio-card-header-deletable { padding-right: 25px; }
.becs-graph-studio .studio-card .studio-node-delete { position: absolute; top: 3px; right: 3px; width: 16px; min-width: 16px; height: 16px; min-height: 16px; max-width: 16px; max-height: 16px; padding: 0; margin: 0; border-width: 0; border-radius: 8px; background-image: none; font-size: 12px; -unity-font-style: normal; -unity-text-align: middle-center; }
.becs-graph-studio .studio-breadcrumbs { flex-direction: row; align-items: center; flex-wrap: wrap; min-height: 28px; }
.becs-graph-studio .studio-breadcrumbs .studio-breadcrumb-item { border-width: 0; border-radius: 3px; padding: 3px 6px; margin: 0; font-size: 11px; min-height: 24px; }
.becs-graph-studio .studio-breadcrumbs .studio-breadcrumb-current { -unity-font-style: bold; }
.becs-graph-studio .studio-breadcrumb-separator { font-size: 13px; opacity: 0.45; padding: 0 2px; }
.becs-graph-studio .studio-card-fields .unity-base-field__label,
.becs-graph-studio .studio-card-fields .studio-field-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.becs-graph-studio .studio-card-fields .studio-vector-field { flex-direction: column; align-items: stretch; }
.becs-graph-studio .studio-card-fields .studio-vector-field > .unity-base-field__label { width: auto; min-width: 0; margin-bottom: 3px; }
.becs-graph-studio .studio-card-fields .studio-vector-field > .unity-base-field__input { width: auto; min-width: 0; flex-grow: 1; }
.becs-graph-studio .studio-card-fields .studio-vector-field .unity-base-vector-field__field { min-width: 0; flex-basis: 0; flex-grow: 1; margin-left: 2px; margin-right: 2px; }
.becs-graph-studio .studio-card-fields .studio-vector-field .unity-base-vector-field__field .unity-base-field__label { width: 12px; min-width: 12px; flex-grow: 0; flex-shrink: 0; margin-left: 0; margin-right: 2px; padding: 0; }
.becs-graph-studio .studio-card-fields .studio-vector-field .unity-base-vector-field__field .unity-base-field__input { min-width: 0; flex-grow: 1; }
.becs-graph-studio .studio-readonly-vector { margin-top: 4px; margin-bottom: 8px; }
.becs-graph-studio .studio-readonly-vector-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 3px; }
.becs-graph-studio .studio-readonly-vector-row { flex-direction: row; align-items: center; min-height: 20px; }
.becs-graph-studio .studio-readonly-vector-axis { width: 16px; min-width: 16px; opacity: 0.65; }
.becs-graph-studio .studio-readonly-vector-value { flex-grow: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 2px 6px; border-radius: 3px; }
.becs-graph-studio .studio-card { overflow: visible; }
.becs-graph-studio .studio-card .studio-ports { padding: 0; margin: 0; }
.becs-graph-studio .studio-card-header { padding-left: 14px; padding-right: 14px; }
.becs-graph-studio .studio-card-header-deletable { padding-right: 25px; }
.becs-graph-studio .studio-boundary-card .studio-card-header,
.becs-graph-studio .studio-boundary-card .studio-card-title { border-bottom-width: 0; }
.becs-graph-studio .studio-card-fields .studio-editable-vector .unity-base-field__label { width: 16px; min-width: 16px; margin-right: 4px; white-space: nowrap; }
.becs-graph-studio .studio-editable-vector .unity-base-field { min-width: 0; }
.becs-graph-studio .studio-editable-vector .unity-base-field__input { flex-grow: 1; min-width: 0; }
.becs-graph-studio .studio-card-fields .vector-field,
.becs-graph-studio .studio-card-fields .quaternion-field,
.becs-graph-studio .studio-card-fields .root > .container { flex-direction: column; align-items: stretch; min-width: 0; }
.becs-graph-studio .studio-card-fields .vector-field FloatField,
.becs-graph-studio .studio-card-fields .quaternion-field FloatField { width: auto; min-width: 0; flex-grow: 1; }
.becs-graph-studio .studio-card-fields .vector-field .unity-base-field__label,
.becs-graph-studio .studio-card-fields .quaternion-field .unity-base-field__label { width: 16px; min-width: 16px; margin-right: 4px; }
.becs-graph-studio .studio-card-fields .vector-field > Label,
.becs-graph-studio .studio-card-fields .quaternion-field > Label { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.becs-graph-studio .studio-card-fields .fp-field .unity-base-field__input,
.becs-graph-studio .studio-card-fields .root .unity-base-field__input { min-width: 0; flex-grow: 1; }
.becs-graph-studio .studio-fixedpoint-composite { margin-top: 4px; margin-bottom: 8px; padding-left: 4px; }
.becs-graph-studio .studio-card-fields .studio-inline-vector { flex-direction: row; align-items: center; margin: 3px 0; min-width: 0; }
.becs-graph-studio .studio-inline-vector > .studio-readonly-vector-title { width: 64px; min-width: 0; flex-shrink: 0; margin: 0 4px 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.becs-graph-studio .studio-inline-vector > .studio-inline-component,
.becs-graph-studio .studio-inline-vector > .studio-readonly-vector-row { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin: 0 1px; }
.becs-graph-studio .studio-card-fields .studio-inline-component .unity-base-field { margin: 0; min-width: 0; }
.becs-graph-studio .studio-card-fields .studio-inline-component .unity-base-field__label { width: 10px; min-width: 10px; margin: 0 1px 0 0; padding: 0; }
.becs-graph-studio .studio-inline-component .unity-base-field__input { min-width: 0; flex-grow: 1; padding-left: 2px; padding-right: 2px; }
.becs-graph-studio .studio-inline-vector .studio-readonly-vector-axis { width: 10px; min-width: 10px; }
.becs-graph-studio .studio-inline-vector .studio-readonly-vector-value { padding: 2px; }
.becs-graph-studio .studio-canvas-host > .empty-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.5);
}
