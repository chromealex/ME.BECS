@import url("Default.uss");

:root {
    --main-color: var(--unity-colors-window-background);
    --dark-color: var(--unity-colors-window-background);
    --highlight-color: #939393;
    --toolbar-color: #2d2d2d;
    --becs-accent: #939393;
    --becs-selection: #505050;
    /* Follow the active Unity editor skin rather than approximating its background. */
    --content-background-color: var(--unity-colors-window-background);
    --becs-background-dark: var(--unity-colors-window-background);
    --becs-background-light: var(--unity-colors-window-background);
    --becs-surface-dark: #2d2d2d;
    --becs-border-dark: #454545;
    --toolbar-buttons-background-color: #151515;
    --toolbar-buttons-background-color-hover: #1e1e1e;
    --toolbar-buttons-border-color: #454545;
    --becs-button-dark: #151515;
    --becs-button-hover-dark: #1e1e1e;
}
