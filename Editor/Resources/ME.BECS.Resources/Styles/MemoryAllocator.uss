.allocator-dashboard { flex-grow: 1; padding: 12px; }
.allocator-dashboard .allocator-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.allocator-dashboard .allocator-row > Label { margin-right: 12px; }
.allocator-dashboard .allocator-counters { font-size: 14px; white-space: normal; margin-top: 8px; margin-bottom: 14px; }
.allocator-dashboard .allocator-search { margin-top: 6px; margin-bottom: 8px; }
.allocator-dashboard .allocator-suggestions { padding: 4px; background-color: rgba(100, 110, 130, 0.12); }
.allocator-dashboard .allocator-suggestion { -unity-text-align: middle-left; height: 26px; }
.allocator-dashboard .allocator-suggestion.active { background-color: rgb(57, 95, 133); color: white; }
.allocator-dashboard .allocator-map-scroll { min-height: 90px; height: 210px; flex-shrink: 1; margin-bottom: 12px; }
.allocator-dashboard .allocator-map { flex-grow: 1; height: 22px; background-color: rgb(38, 40, 44); }
.allocator-dashboard .allocator-lower { flex-grow: 1; align-items: stretch; min-height: 200px; }
.allocator-dashboard .allocator-table { flex-grow: 1; flex-basis: 55%; min-width: 220px; margin-right: 12px; }
.allocator-dashboard .allocator-inspector { flex-grow: 1; flex-basis: 45%; min-width: 220px; padding-left: 12px; border-left-width: 1px; border-left-color: rgba(128, 128, 128, 0.4); }
.allocator-dashboard .allocator-trace { flex-grow: 1; margin-top: 12px; min-height: 100px; }
.allocator-dashboard .allocator-trace .unity-text-field__input { white-space: normal; }
.allocator-dashboard .allocator-allocation-row { flex-direction: row; align-items: center; height: 34px; padding-left: 6px; padding-right: 6px; }
.allocator-dashboard .allocator-allocation-row #component { flex-grow: 1; flex-basis: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.allocator-dashboard .allocator-allocation-row #size { width: 85px; -unity-text-align: middle-right; margin-right: 10px; }
.allocator-dashboard .allocator-allocation-row #offset { width: 120px; }
.allocator-dashboard .allocator-row { flex-wrap: wrap; }
.allocator-dashboard Button.active { background-color: rgb(57, 95, 133); color: white; }
.allocator-dashboard Button {
    min-height: 26px;
    padding: 4px 10px;
    margin: 2px 4px 2px 0px;
    border-width: var(--toolbar-buttons-border-width);
    border-radius: var(--toolbar-buttons-radius);
    border-color: var(--toolbar-buttons-border-color);
    background-color: var(--toolbar-buttons-background-color);
}
.allocator-dashboard Button:hover { background-color: var(--toolbar-buttons-background-color-hover); }
.allocator-dashboard.dark Button { color: #e8eaf0; }
.allocator-dashboard.light Button { color: #242831; }
.allocator-dashboard Button.active { background-color: #395f85; color: white; }
.allocator-dashboard .allocator-map-row { flex-wrap: nowrap; flex-shrink: 0; }
.allocator-dashboard .allocator-map-row > Label { flex-shrink: 0; }
.allocator-dashboard .allocator-map { min-width: 0; height: 24px; }
.allocator-dashboard .allocator-map-scroll { height: 280px; min-height: 140px; }
