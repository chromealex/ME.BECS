/* Window-specific layout. Shared appearance lives in DefaultStyles.uss. */
.replays-window { flex-grow: 1; }

.replays-window .rewind-pause-message { margin: 8px 12px; }

.replays-window .replay-toolbar,
.replays-window .tick-controls { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 8px 12px; }

.replays-window .replay-toolbar > *,
.replays-window .tick-controls > * { margin-right: 6px; }

.replays-window .space { flex-grow: 1; }

.replays-window .empty-state { white-space: normal; -unity-text-align: middle-center; padding: 48px 24px; flex-grow: 1; }

.replays-window .replay-scroll { flex-grow: 1; }

.replays-window .tick-controls TextField { width: 165px; }

.replays-window .tick-controls TextField > Label { min-width: 28px; }

.replays-window .timeline-row { flex-direction: row; margin: 8px 16px 16px 16px; }

.replays-window .track-labels { width: 72px; flex-shrink: 0; }

.replays-window .track-labels > Label { height: 44px; padding-top: 12px; margin: 0; }

.replays-window .track-labels > Label:first-child { height: 26px; }

.replays-window .timeline { flex-grow: 1; height: 204px; min-width: 0; }

.replays-window .axis { height: 26px; flex-direction: row; justify-content: space-between; }

.replays-window .track { height: 44px; border-bottom-width: 1px; }

.replays-window .mark { position: absolute; top: 14px; width: 7px; height: 15px; margin-left: -4px; border-radius: 2px; }

.replays-window .local .mark { height: 8px; top: 18px; border-radius: 4px; }

.replays-window .remote .mark { height: 8px; top: 18px; }

.replays-window .mark:hover { opacity: 0.65; }

.replays-window .current-cursor,
.replays-window .target-cursor { position: absolute; top: 26px; height: 132px; width: 2px; }

.replays-window .target-cursor { width: 1px; }

.replays-window .rewind-buffer { position: absolute; top: 167px; height: 6px; }

.replays-window .scrubber { position: absolute; left: 0; right: 0; top: 178px; margin-left: 0; margin-right: 0; }

.replays-window .selection-summary { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin: 8px 16px; padding: 12px 0; border-top-width: 1px; }

.replays-window .selection-summary > Label { white-space: normal; }

.replays-window .events-header { opacity: 0.7; }

.replays-window .event-action { width: 60px; }

.replays-window .event-row > Button { width: 60px; }

.replays-window .no-events { margin: 12px 16px; }

.replays-window .event-row { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 8px 16px; border-bottom-width: 1px; }

.replays-window .event-row > Label { min-width: 55px; margin-right: 8px; }

.replays-window .event-method { flex-grow: 1; white-space: normal; }

.replays-window .replay-footer { padding: 10px 16px; white-space: normal; border-top-width: 1px; }

.replays-window .replay-toolbar { flex-shrink: 0; }
